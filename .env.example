# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
NODE_ENV=production
PORT=5000
API_VERSION=v1

# ─────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────
# ─────────────────────────────────────────────
# DATABASE
# Railway injects DATABASE_URL automatically when you add a Postgres plugin.
# It takes priority over the individual DB_* variables below.
# For local development, leave DATABASE_URL blank and fill in DB_* instead.
# ─────────────────────────────────────────────
DATABASE_URL=

# Local development fallback (ignored when DATABASE_URL is set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=YOUR_DATABASE_NAME_HERE
DB_PASSWORD=YOUR_PASSWORD_HERE
DB_USER=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_SECRET=121b07e9e1ea53710a38b3964c05d5106634d63c4b67ca0046f439c6121b9d0d29d216d7ae0bcabca847be590a1a2c4a109f3c604e03e43836d79f444e5c118d
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=df91b63b5fe9e8feefad9b63198bf9fd024f87c38863554496e5745ac393bf34d9932e1190a896376e8c09e2bba7ad34ad75f25db76bdeef1e2a07810e822627
JWT_REFRESH_EXPIRES_IN=30d

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs
